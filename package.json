{
  "version": "1.0.0",
  "private": true,
  "name": "extends-ai",
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter extends-ai-main dev",
    "typecheck": "pnpm --filter extends-ai-main --filter browser-partition-* --filter codex-app-server-* --filter login-* -r --if-present typecheck",
    "build": "pnpm typecheck && pnpm --filter extends-ai-main build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "tsx": "^4.20.0",
      "typescript": "^5.8.0"
    }
  }
}
