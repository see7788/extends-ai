{
  "version": "1.0.1",
  "private": true,
  "name": "extends-ai",
  "type": "module",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite --config apps/test/vite.config.ts --configLoader runner",
    "main:dev": "pnpm --filter extends-ai-main dev",
    "treeask:dev": "vite --config apps/test/vite.config.ts --configLoader runner",
    "treeask:build": "vite build --config apps/test/vite.config.ts --configLoader runner",
    "typecheck": "pnpm --filter extends-ai-main --filter browser-partition-* --filter codex-app-server-* --filter chatgtp-com-login-* --filter aiserver --filter treeask -r --if-present typecheck",
    "build": "pnpm typecheck && pnpm --filter extends-ai-main build"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/vite-dev-server": "0.26.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "hono-vite-config": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "tsx": "^4.20.0",
      "typescript": "^5.8.0",
      "vite": "8.0.11"
    }
  }
}
